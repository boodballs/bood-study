# Together.ai (GLM-5.3-Flash) — study material generation
TOGETHER_MODEL=zai-org/GLM-5.3-Flash
TOGETHER_API_KEY=

# Public URL of the study app (used for metadata / email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Abuse protection
# Global daily cap on AI generations (all users combined) — the cost fuse.
DAILY_GLOBAL_LIMIT=300
# Cloudflare Turnstile (optional): create a widget at dash.cloudflare.com -> Turnstile,
# then set both keys. Without them, captcha checks are skipped.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=Bood Study <study@boodautomates.com>
